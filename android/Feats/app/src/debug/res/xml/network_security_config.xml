<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config. Overrides the main config for debug
  builds, permitting cleartext HTTP to the dev backend only:
    - 10.0.2.2  : the host machine as seen from the Android emulator
    - localhost : for a device on the same host via adb reverse
  Everything else still requires TLS. Release builds do not include this
  file and keep the locked-down main config.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
    </domain-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
