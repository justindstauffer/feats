# Server
PORT=8080
GIN_MODE=debug
# Comma-separated list of trusted proxy IPs/CIDRs for X-Forwarded-For processing.
# Leave empty to trust no proxies (secure default).
# Example: TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=

# Database
DATABASE_PATH=./feats.db

# JWT (REQUIRED - generate a secure random string of at least 32 characters)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Storage
STORAGE_PATH=./storage
STORAGE_BACKEND=local
MAX_IMAGE_SIZE_MB=10

# Security
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m
RATE_LIMIT_API=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=20
PASSWORD_RESET_TTL=1h
SESSION_INACTIVE_TTL=720h
AUDIT_LOG_RETENTION=90
SOFT_DELETE_RETENTION=30

# APNs (for push notifications - configure when ready)
# APNS_KEY_PATH=
# APNS_KEY_ID=
# APNS_TEAM_ID=

# General
TIMEZONE=UTC
