# Production Environment Configuration
# Copy to .env.production and fill in your values

# Server
PORT=8080
GIN_MODE=release

# Database (use absolute path in production)
DATABASE_PATH=/app/data/feats.db

# JWT - REQUIRED: Generate with: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_64_CHARACTER_RANDOM_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Storage
STORAGE_PATH=/app/storage
STORAGE_BACKEND=local
MAX_IMAGE_SIZE_MB=10

# Security (production settings)
BCRYPT_COST=12
LOGIN_MAX_ATTEMPTS=5
LOCKOUT_DURATION=15m
RATE_LIMIT_API=100
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=20
PASSWORD_RESET_TTL=1h
SESSION_INACTIVE_TTL=720h
AUDIT_LOG_RETENTION=90
SOFT_DELETE_RETENTION=30

# Timezone
TIMEZONE=America/New_York

# APNs (for push notifications - configure when ready)
# APNS_KEY_PATH=
# APNS_KEY_ID=
# APNS_TEAM_ID=
